{
  "schemaVersion": 2,
  "environment": "production",
  "configuration": [
    {"name":"APP_ENVIRONMENT","kind":"literal","expected":"production"},
    {"name":"APP_PUBLIC_HOST","kind":"public-host"},
    {"name":"FILES_PUBLIC_HOST","kind":"public-host"},
    {"name":"WEBAUTHN_RP_ID","kind":"public-host"},
    {"name":"WEBAUTHN_ALLOWED_ORIGINS","kind":"https-origin-list"},
    {"name":"DB_URL","kind":"jdbc-postgresql-tls-url"},
    {"name":"DB_MAXIMUM_POOL_SIZE","kind":"positive-integer"},
    {"name":"DB_MINIMUM_IDLE","kind":"non-negative-integer"},
    {"name":"VALKEY_URL","kind":"rediss-url"},
    {"name":"S3_REGION","kind":"aws-region"},
    {"name":"S3_ENDPOINT","kind":"amazon-s3-endpoint"},
    {"name":"S3_QUARANTINE_BUCKET","kind":"bucket-name"},
    {"name":"S3_CLEAN_BUCKET","kind":"bucket-name"},
    {"name":"S3_PREVIEW_BUCKET","kind":"bucket-name"},
    {"name":"S3_DELIVERY_BUCKET","kind":"bucket-name"},
    {"name":"MALWARE_SCAN_MODE","kind":"scan-mode"},
    {"name":"CLAMAV_HOST","kind":"conditional-host","when":{"MALWARE_SCAN_MODE":"required"}},
    {"name":"CLAMAV_PORT","kind":"tcp-port"},
    {"name":"CLAMAV_CONNECT_TIMEOUT","kind":"duration"},
    {"name":"CLAMAV_READ_TIMEOUT","kind":"duration"},
    {"name":"CLAMAV_DEFINITION_MAX_AGE_HOURS","kind":"positive-integer"},
    {"name":"MAIL_HOST","kind":"public-host"},
    {"name":"MAIL_PORT","kind":"tcp-port"},
    {"name":"MAIL_FROM_ADDRESS","kind":"email-address"},
    {"name":"APP_IMAGE","kind":"oci-digest"},
    {"name":"EDGE_IMAGE","kind":"oci-digest"},
    {"name":"CONFIG_ROOT","kind":"absolute-directory","expected":"/etc/stageaccord/config"},
    {"name":"SECRETS_ROOT","kind":"absolute-directory","expected":"/etc/stageaccord/secrets"},
    {"name":"RELEASE_EVIDENCE_ROOT","kind":"absolute-directory","expected":"/var/lib/stageaccord/release-evidence"}
  ],
  "secretFiles": [
    {"variable":"DB_USERNAME_FILE","consumer":"application","file":"db-username","minimumBytes":1},
    {"variable":"DB_PASSWORD_FILE","consumer":"application","file":"db-password","minimumBytes":16},
    {"variable":"VALKEY_USERNAME_FILE","consumer":"application","file":"valkey-username","minimumBytes":1},
    {"variable":"VALKEY_PASSWORD_FILE","consumer":"application","file":"valkey-password","minimumBytes":16},
    {"variable":"S3_ACCESS_KEY_ID_FILE","consumer":"application","file":"s3-access-key-id","minimumBytes":16},
    {"variable":"S3_SECRET_ACCESS_KEY_FILE","consumer":"application","file":"s3-secret-access-key","minimumBytes":32},
    {"variable":"S3_WORKER_ACCESS_KEY_ID_FILE","consumer":"worker","file":"s3-access-key-id","minimumBytes":16},
    {"variable":"S3_WORKER_SECRET_ACCESS_KEY_FILE","consumer":"worker","file":"s3-secret-access-key","minimumBytes":32},
    {"variable":"STRIPE_API_KEY_FILE","consumer":"application","file":"stripe-api-key","minimumBytes":16},
    {"variable":"STRIPE_WEBHOOK_SECRET_FILE","consumer":"application","file":"stripe-webhook-secret","minimumBytes":16},
    {"variable":"MAIL_USERNAME_FILE","consumer":"application","file":"smtp-username","minimumBytes":1},
    {"variable":"MAIL_PASSWORD_FILE","consumer":"application","file":"smtp-password","minimumBytes":16},
    {"variable":"SESSION_HMAC_KEY_FILE","consumer":"application","file":"session-hmac-key","minimumBytes":32},
    {"variable":"CSRF_HMAC_KEY_FILE","consumer":"application","file":"csrf-hmac-key","minimumBytes":32},
    {"variable":"FIELD_ENCRYPTION_KEY_FILE","consumer":"application","file":"field-encryption-key","minimumBytes":32},
    {"variable":"EDGE_TLS_CERTIFICATE_FILE","consumer":"edge","file":"tls-certificate","minimumBytes":64},
    {"variable":"EDGE_TLS_PRIVATE_KEY_FILE","consumer":"edge","file":"tls-private-key","minimumBytes":64}
  ]
}

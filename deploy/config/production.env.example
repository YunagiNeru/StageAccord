# 本番管理者が /etc/stageaccord/config/production.env へ複製し、実値を直接記載する。
# 秘密値は記載せず、/etc/stageaccord/secrets 以下の専用ファイルを参照する。
APP_ENVIRONMENT=production
APP_PUBLIC_HOST=__REQUIRED_APP_FQDN__
FILES_PUBLIC_HOST=__REQUIRED_FILES_FQDN__
WEBAUTHN_RP_ID=__REQUIRED_RP_ID__
WEBAUTHN_ALLOWED_ORIGINS=https://__REQUIRED_APP_FQDN__

DB_URL=jdbc:postgresql://__REQUIRED_DB_HOST__:5432/__REQUIRED_DATABASE__?sslmode=verify-full
DB_USERNAME_FILE=/run/secrets/application/db-username
DB_PASSWORD_FILE=/run/secrets/application/db-password
DB_MAXIMUM_POOL_SIZE=30
DB_MINIMUM_IDLE=5

VALKEY_URL=rediss://__REQUIRED_VALKEY_HOST__:6379
VALKEY_USERNAME_FILE=/run/secrets/application/valkey-username
VALKEY_PASSWORD_FILE=/run/secrets/application/valkey-password

S3_REGION=__REQUIRED_AWS_REGION__
S3_ENDPOINT=https://s3.__REQUIRED_AWS_REGION__.amazonaws.com
S3_QUARANTINE_BUCKET=__REQUIRED_QUARANTINE_BUCKET__
S3_CLEAN_BUCKET=__REQUIRED_CLEAN_BUCKET__
S3_PREVIEW_BUCKET=__REQUIRED_PREVIEW_BUCKET__
S3_DELIVERY_BUCKET=__REQUIRED_DELIVERY_BUCKET__
S3_ACCESS_KEY_ID_FILE=/run/secrets/application/s3-access-key-id
S3_SECRET_ACCESS_KEY_FILE=/run/secrets/application/s3-secret-access-key
S3_WORKER_ACCESS_KEY_ID_FILE=/run/secrets/worker/s3-access-key-id
S3_WORKER_SECRET_ACCESS_KEY_FILE=/run/secrets/worker/s3-secret-access-key

MALWARE_SCAN_MODE=bypass
CLAMAV_HOST=__REQUIRED_WHEN_SCAN_MODE_REQUIRED__
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=5s
CLAMAV_READ_TIMEOUT=30m
CLAMAV_DEFINITION_MAX_AGE_HOURS=24

STRIPE_API_KEY_FILE=/run/secrets/application/stripe-api-key
STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/application/stripe-webhook-secret
MAIL_HOST=__REQUIRED_SMTP_HOST__
MAIL_PORT=465
MAIL_FROM_ADDRESS=__REQUIRED_VERIFIED_FROM_ADDRESS__
MAIL_USERNAME_FILE=/run/secrets/application/smtp-username
MAIL_PASSWORD_FILE=/run/secrets/application/smtp-password

SESSION_HMAC_KEY_FILE=/run/secrets/application/session-hmac-key
CSRF_HMAC_KEY_FILE=/run/secrets/application/csrf-hmac-key
FIELD_ENCRYPTION_KEY_FILE=/run/secrets/application/field-encryption-key
EDGE_TLS_CERTIFICATE_FILE=/run/secrets/edge/tls-certificate
EDGE_TLS_PRIVATE_KEY_FILE=/run/secrets/edge/tls-private-key

APP_IMAGE=__REQUIRED_REGISTRY_PATH__@sha256:__REQUIRED_64_HEX_DIGEST__
EDGE_IMAGE=__REQUIRED_REGISTRY_PATH__@sha256:__REQUIRED_64_HEX_DIGEST__
CONFIG_ROOT=/etc/stageaccord/config
SECRETS_ROOT=/etc/stageaccord/secrets
RELEASE_EVIDENCE_ROOT=/var/lib/stageaccord/release-evidence

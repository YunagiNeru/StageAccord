worker_processes auto;
pid /var/run/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 2048; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  access_log /dev/stdout combined;
  client_max_body_size 1m;
  proxy_request_buffering off;
  proxy_buffering off;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  upstream application_upstream { server application:8080; keepalive 32; }

  server {
    listen 8080;
    server_name ${APP_PUBLIC_HOST} ${FILES_PUBLIC_HOST};
    return 308 https://$host$request_uri;
  }

  server {
    listen 8443 ssl http2;
    server_name ${APP_PUBLIC_HOST} ${FILES_PUBLIC_HOST};
    ssl_certificate /run/secrets/edge/tls-certificate;
    ssl_certificate_key /run/secrets/edge/tls-private-key;
    ssl_protocols TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;

    location / {
      proxy_pass http://application_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}

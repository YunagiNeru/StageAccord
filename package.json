{
  "name": "stage-accord-build",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=10.29.1 <11"
  },
  "scripts": {
    "dev:web": "pnpm --dir web dev",
    "build:web": "pnpm --dir web build",
    "typecheck:web": "pnpm --dir web typecheck",
    "test:web": "pnpm --dir web test",
    "test:web-e2e": "pnpm --dir web test:e2e",
    "generate:web-api": "pnpm --dir web generate:api",
    "verify:traceability": "python scripts/verify_traceability.py",
    "test:traceability": "python -m unittest scripts/test_verify_traceability.py",
    "generate:test-manifest": "python scripts/generate_test_manifest.py",
    "verify:test-manifest": "python scripts/generate_test_manifest.py --check",
    "test:test-manifest": "python -m unittest scripts/test_generate_test_manifest.py",
    "generate:openapi": "python scripts/generate_openapi.py",
    "verify:openapi": "python scripts/generate_openapi.py --check",
    "test:openapi": "python -m unittest scripts/test_generate_openapi.py",
    "report:http-implementation": "python scripts/verify_http_implementation.py",
    "test:http-implementation": "python -m unittest scripts/test_verify_http_implementation.py",
    "test:backend": "mvn -f backend/pom.xml test",
    "test:phase9-runner": "python -m unittest scripts/test_run_phase9_verification.py",
    "verify:phase9": "python scripts/run_phase9_verification.py",
    "verify:production-config": "python deploy/scripts/preflight_production.py --schema-only",
    "test:production-config": "python -m unittest deploy/scripts/test_preflight_production.py",
    "verify:release-artifacts": "python deploy/scripts/verify_release_artifacts.py",
    "verify": "pnpm verify:traceability && pnpm verify:test-manifest && pnpm verify:openapi && pnpm test:phase9-runner && pnpm test:backend && pnpm typecheck:web && pnpm test:web && pnpm build:web && pnpm test:web-e2e && pnpm test:production-config"
  }
}
